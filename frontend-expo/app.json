{
  "expo": {
    "name": "frontend-expo",
    "slug": "frontend-expo",
    "scheme": "com.peakplay.itcp239",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.peakplay.itcp239",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ea580c",
          "defaultChannel": "default",
          "projectId": "revnation-8b916"
        }
      ],
      "expo-sqlite"
    ],
    "notification": {
      "channel": "default"
    },
    "extra": {
      "eas": {
        "projectId": "c1fc75f7-b878-4076-8bf6-4b7fc35f0762"
      }
    },
    "owner": "richardainthony"
  }
}
